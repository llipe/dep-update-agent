# Python
__pycache__/
*.py[cod]
.venv/
.python-version

# Node
node_modules/

# CDK output
cdk.out/
dist/

# Secrets / local config
.env
.env.*
*.pem

# Corporate proxy CA certs — machine-specific, injected at build time
dependencyUpdateAgent/app/depUpdateAgent/ca/*.crt
!dependencyUpdateAgent/app/depUpdateAgent/ca/.keep

# AgentCore CLI local state (account-specific, never publish)
**/agentcore/aws-targets.json
**/agentcore/.cli/

# OS
.DS_Store
